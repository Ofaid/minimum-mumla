{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awatchar.github.io/minimum/schema/config.schema.json",
  "title": "Minimum radio configuration",
  "type": "object",
  "required": ["schemaVersion", "configVersion", "mumble", "ui", "ptt", "rooms", "hardware"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "configVersion": { "type": "integer", "minimum": 1 },
    "deviceId": { "type": "string", "pattern": "^(\\*|[A-Z0-9]{6})$" },
    "mumble": {
      "type": "object",
      "required": ["serverId", "host", "port", "defaultRoom"],
      "properties": {
        "serverId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "host": { "type": "string", "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "defaultRoom": { "type": "string", "minLength": 1, "maxLength": 128 },
        "autoConnect": { "type": "boolean" },
        "autoReconnect": { "type": "boolean" }
      }
    },
    "ui": { "type": "object" },
    "ptt": {
      "type": "object",
      "required": ["maximumTxSeconds", "releaseOnNetworkLoss"],
      "properties": {
        "maximumTxSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "allowScreenOff": { "type": "boolean" },
        "releaseOnNetworkLoss": { "type": "boolean", "const": true }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "path", "access"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "label": { "type": "string", "maxLength": 128 },
          "path": { "type": "string", "pattern": "^/" },
          "presetKey": { "type": "string", "pattern": "^P[1-8]$" },
          "access": { "type": "object" }
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pttKeyCode": { "type": "integer", "minimum": 0 },
        "pttScanCode": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
